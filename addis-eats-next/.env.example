# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; THIS file is committed, so it must only ever
# contain dummy values.

# --- Server-only (never exposed to the browser) ---------------------------
# Secret used to sign the session cookie (lib/session-token.js).
# Generate a real one with:  openssl rand -base64 32
# If unset, the app falls back to an insecure dev-only secret.
SESSION_SECRET=replace-with-a-long-random-string

# --- Public (NEXT_PUBLIC_ = inlined into the browser bundle) --------------
# Google Analytics 4 measurement ID (looks like G-AB12CD34EF). Leave EMPTY to
# disable analytics - an invalid id loads a script that does nothing.
# The script is loaded lazily via next/script (app/components/Analytics.jsx).
NEXT_PUBLIC_GA_ID=

# Public address of the deployed site, no trailing slash. Used for canonical
# URLs, og:image, sitemap.xml and robots.txt. Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL=https://addis-eats.example.com
